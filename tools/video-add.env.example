# W41IT video-add server configuration
# Copy to ~/.config/w41it/video-add.env and chmod 600.
# Never commit the real API key.
#
# Appwrite API-key scopes used by video-add:
#   tables.read, tables.write
#   columns.read, columns.write
#   rows.read, rows.write

APPWRITE_API_KEY=PASTE_SERVER_API_KEY_HERE
VIDEO_ADMIN_USER_ID=PASTE_APPWRITE_AUTH_USER_ID_HERE

# Defaults below already match the current W41IT setup; uncomment only to override.
# APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=6a0878e40013d0103042
# APPWRITE_DATABASE_ID=6a087bfc0014b3277171
# VIDEO_CATALOG_TABLE_ID=video_catalog
# VIDEO_CATALOG_ROW_ID=current
# VIDEO_R2_REMOTE=r2:w41it-video
# VIDEO_MEDIA_ROOT=/srv/media
# VIDEO_FRONTEND_REPO=/home/fedora/repos/briansmediaserver
