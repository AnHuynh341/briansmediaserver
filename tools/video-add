def die(message: str, code: int = 1) -> None:
    print(f"\nERROR: {message}", file=sys.stderr)
    raise SystemExit(code)


def info(message: str) -> None:
    print(f"\n==> {message}")


def warn(message: str) -> None:
    print(f"WARNING: {message}", file=sys.stderr)


def need(command: str) -> Path:
    path = shutil.which(command)
    if not path:
        die(f"Missing required command: {command}")
    return Path(path)


def api_key() -> str:
    value = os.environ.get("APPWRITE_API_KEY", "").strip()
    if not value:
        die(
            "APPWRITE_API_KEY is missing. Put APPWRITE_API_KEY=... in "
            "~/.config/w41it/video-add.env (chmod 600)."
        )
    return value


def api(method: str, path: str, data=None, allow=()):
    body = None if data is None else json.dumps(data, ensure_ascii=False).encode()
    request = urllib.request.Request(
        ENDPOINT + path,
        data=body,
        method=method,
        headers={
            "Content-Type": "application/json",
            "X-Appwrite-Project": PROJECT,
            "X-Appwrite-Key": api_key(),
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            raw = response.read()
            return response.status, json.loads(raw) if raw else None
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="replace")
        if error.code in allow:
            try:
                return error.code, json.loads(raw) if raw else None
            except Exception:
                return error.code, None
        try:
            message = json.loads(raw).get("message", raw)
        except Exception:
            message = raw
        die(f"Appwrite HTTP {error.code}: {message}")


def create_schema() -> None:
    """Create/update the TablesDB table and its two columns."""
    info("Preparing Appwrite TablesDB video catalog")

    status, _ = api(
        "GET",
        f"/tablesdb/{DATABASE}/tables/{TABLE}",
        allow=(404,),
    )

    table_data = {
        "name": "Video Catalog",
        "permissions": ['read("any")'],
        "rowSecurity": True,
        "enabled": True,
    }

    if status == 404:
        api(
            "POST",
            f"/tablesdb/{DATABASE}/tables",
            {"tableId": TABLE, **table_data},
        )
        print(f"  created table: {TABLE}")
    else:
        api(
            "PUT",
            f"/tablesdb/{DATABASE}/tables/{TABLE}",
            {**table_data, "purge": True},
        )
        print(f"  exists: {TABLE} (row security enabled)")

    columns = [
        (
            "longtext",
            "payload",
            {
                "key": "payload",
                "required": True,
                "array": False,
                "encrypt": False,
            },
        ),
        (
            "string",
            "updatedAt",
            {
                "key": "updatedAt",
                "size": 64,
                "required": False,
                "default": "",
                "array": False,
                "encrypt": False,
            },
        ),
    ]

    for column_type, column_name, payload in columns:
        status, _ = api(
            "POST",
            f"/tablesdb/{DATABASE}/tables/{TABLE}/columns/{column_type}",
            payload,
            allow=(409,),
        )
        print(
            f"  {'exists' if status == 409 else 'created'} column: {column_name}"
        )

    deadline = time.time() + 90
    while time.time() < deadline:
        _, data = api(
            "GET", f"/tablesdb/{DATABASE}/tables/{TABLE}/columns"
        )
        columns = (data or {}).get("columns", [])
        wanted = [column for column in columns if column.get("key") in {"payload", "updatedAt"}]
        if any(column.get("status") == "failed" for column in wanted):
            die("Appwrite catalog column creation failed")
        if len(wanted) == 2 and all(
            column.get("status") in (None, "available") for column in wanted
        ):
            return
        time.sleep(1)

    die("Timed out waiting for Appwrite catalog columns")


def get_catalog():
    status, row = api(
        "GET",
        f"/tablesdb/{DATABASE}/tables/{TABLE}/rows/{ROW}",
        allow=(404,),
    )
    if status == 404:
        die("Appwrite video catalog is not initialized. Run: video-add --init-appwrite")
    try:
        return json.loads(row["payload"])
    except Exception as error:
        die(f"Invalid Appwrite video catalog JSON: {error}")


def catalog_permissions() -> list[str]:
    permissions = ['read("any")']
    if ADMIN_USER_ID:
        permissions += [
            f'update("user:{ADMIN_USER_ID}")',
            f'delete("user:{ADMIN_USER_ID}")',
        ]
    return permissions


def save_catalog(catalog) -> None:
    payload = json.dumps(catalog, ensure_ascii=False, separators=(",", ":"))
    api(
        "PUT",
        f"/tablesdb/{DATABASE}/tables/{TABLE}/rows/{ROW}",
        {
            "data": {
                "payload": payload,
                "updatedAt": datetime.now(timezone.utc).isoformat(),
            },
            "permissions": catalog_permissions(),
        },
    )


def catalog_blocks(text: str) -> str:
    positions = (
        text.find("const VIDEO_SERIES"),
        text.find("const YOUTUBE_CHANNELS"),
        text.find("const VIDEO_EPISODE_DURATIONS"),
    )
    if min(positions) < 0:
        die("Could not find VIDEO_SERIES/YOUTUBE_CHANNELS in catalog JS")
    return (
        text[positions[0] : positions[1]]
        + "\n"
        + text[positions[1] : positions[2]]
    )


def parse_js(path: Path):
    need("node")
    source = (
        catalog_blocks(path.read_text(encoding="utf-8"))
        + "\nconsole.log(JSON.stringify({VIDEO_SERIES,YOUTUBE_CHANNELS}));\n"
    )
    with tempfile.NamedTemporaryFile(
        "w", suffix=".js", encoding="utf-8", delete=False
    ) as handle:
        handle.write(source)
        name = handle.name
    try:
        result = subprocess.run(["node", name], text=True, capture_output=True)
        if result.returncode:
            die("Catalog parser failed:\n" + result.stderr)
        return json.loads(result.stdout)
    finally:
        Path(name).unlink(missing_ok=True)


def javascript(value, indent: int = 0) -> str:
    pad = " " * indent
    child = " " * (indent + 4)
    if isinstance(value, dict):
        if not value:
            return "{}"
        rows = []
        for key_name, item in value.items():
            rendered_key = (
                key_name
                if re.fullmatch(r"[A-Za-z_$][\w$]*", str(key_name))
                else json.dumps(str(key_name), ensure_ascii=False)
            )
            rows.append(
                f"{child}{rendered_key}: {javascript(item, indent + 4)}"
            )
        return "{\n" + ",\n".join(rows) + "\n" + pad + "}"
    if isinstance(value, list):
        if not value:
            return "[]"
        return (
            "[\n"
            + ",\n".join(child + javascript(item, indent + 4) for item in value)
            + "\n"
            + pad
            + "]"
        )
    if value is True:
        return "true"
    if value is False:
        return "false"
    if value is None:
        return "null"
    if isinstance(value, (int, float)):
        return str(value)
    return json.dumps(str(value), ensure_ascii=False)


def engine_catalog(live):
    catalog = copy.deepcopy(live)
    for series in catalog.get("VIDEO_SERIES", []):
        series["title"] = (
            series.get("sourceTitle") or series.get("title") or series.get("id", "")
        )
    for channel in catalog.get("YOUTUBE_CHANNELS", []):
        channel["name"] = (
            channel.get("sourceName") or channel.get("name") or channel.get("id", "")
        )
    return catalog


def render_js(catalog) -> str:
    return (
        f"const VIDEO_SERIES = {javascript(catalog.get('VIDEO_SERIES', []))};\n\n"
        f"const YOUTUBE_CHANNELS = {javascript(catalog.get('YOUTUBE_CHANNELS', []))};\n\n"
        "const VIDEO_EPISODE_DURATIONS = [];\n"
    )


def merge_display(old, new):
    old_series = {item.get("id"): item for item in old.get("VIDEO_SERIES", [])}
    for series in new.get("VIDEO_SERIES", []):
        previous = old_series.get(series.get("id"), {})
        source = (
            series.get("title")
            or series.get("sourceTitle")
            or series.get("id", "")
        )
        series["sourceTitle"] = source
        series["displayTitle"] = (
            previous.get("displayTitle") or previous.get("title") or source
        )

    old_channels = {
        item.get("id"): item for item in old.get("YOUTUBE_CHANNELS", [])
    }
    for channel in new.get("YOUTUBE_CHANNELS", []):
        previous = old_channels.get(channel.get("id"), {})
        source = (
            channel.get("name")
            or channel.get("sourceName")
            or channel.get("id", "")
        )
        channel["sourceName"] = source
        channel["displayName"] = (
            previous.get("displayName") or previous.get("name") or source
        )
    return new


def seed_legacy():
    if not LEGACY.is_file():
        die(f"Missing legacy catalog: {LEGACY}")
    catalog = parse_js(LEGACY)
    return merge_display(
        {"VIDEO_SERIES": [], "YOUTUBE_CHANNELS": []}, catalog
    )


def replace_python_function_block(
    text: str,
    start_marker: str,
    end_marker: str,
    replacement: str,
) -> str:
    start = text.find(start_marker)
    end = text.find(end_marker, start + len(start_marker))
    if start < 0 or end < 0:
        die(
            "Installed anime-add has a newer incompatible thumbnail workflow; "
            "update video-add/anime-add together"
        )
    return text[:start] + replacement.rstrip() + "\n\n\n" + text[end:]


def patch_anime_thumbnail_picker(text: str) -> str:
    text = replace_python_function_block(
        text,
        "def validate_image_source(",
        "def probe(",
        ANIME_IMAGE_PICKER,
    )
    return replace_python_function_block(
        text,
        "def select_series_artwork(",
        "def change_series_thumbnail(",
        ANIME_ARTWORK_SELECTOR,
    )


def patch_engine(text: str, kind: str) -> str:
    old = '''        if not keep_source and not no_push:\n            for job in jobs:\n                remove_processed_source(job.source)\n        elif not keep_source and no_push:\n            warn("Source files were kept because --no-push was used")'''
    new = '''        media_manifest = os.environ.get("VIDEO_ADD_MEDIA_MANIFEST")\n        if media_manifest:\n            with open(media_manifest, "a", encoding="utf-8") as handle:\n                for job in jobs:\n                    handle.write(str(job.final_dir) + "\\n")\n\n        if not keep_source:\n            source_manifest = os.environ.get("VIDEO_ADD_SOURCE_MANIFEST")\n            if source_manifest:\n                with open(source_manifest, "a", encoding="utf-8") as handle:\n                    for job in jobs:\n                        handle.write(str(job.source) + "\\n")'''
    if old not in text:
        die(
            "Installed anime-add/youtube-add is a newer incompatible version; "
            "update video-add"
        )
    patched = text.replace(old, new, 1)
    if kind == "anime":
        patched = patch_anime_thumbnail_picker(patched)
    return patched


def cleanup_sources(kind: str, manifest: Path) -> None:
    if not manifest.is_file():
        return

    roots = {
        "anime": Path(os.environ.get("ANIME_DOWNLOAD_DIR", "/srv/torrents/anime")),
        "youtube": Path(os.environ.get("YOUTUBE_DOWNLOAD_DIR", "/srv/youtube-source")),
    }
    root = roots[kind].resolve()
    info("Removing processed source downloads")

    for line in dict.fromkeys(manifest.read_text().splitlines()):
        if not line.strip():
            continue
        source = Path(line.strip())
        try:
            resolved = source.resolve()
            resolved.relative_to(root)
        except Exception:
            print(f"  kept source outside download root: {source}")
            continue

        parent = resolved.parent
        if kind == "anime" and parent != root:
            others = [
                path
                for path in parent.rglob("*")
                if path.is_file()
                and path.resolve() != resolved
                and path.suffix.lower() in VIDEO_SUFFIXES
            ]
            if others:
                resolved.unlink(missing_ok=True)
                print(
                    f"  removed source: {resolved}; folder kept "
                    f"({len(others)} video(s) remain)"
                )
                continue

        resolved.unlink(missing_ok=True)
        if parent != root and parent.exists():
            others = [
                path
                for path in parent.rglob("*")
                if path.is_file() and path.suffix.lower() in VIDEO_SUFFIXES
            ]
            if not others:
                shutil.rmtree(parent, ignore_errors=True)
                print(f"  removed source folder: {parent}")
        else:
            print(f"  removed source: {resolved}")


def remove_empty_media_parents(path: Path, root: Path) -> None:
    parent = path.parent
    while parent != root:
        try:
            parent.rmdir()
        except OSError:
            return
        parent = parent.parent


def cleanup_published_media(kind: str, manifest: Path) -> None:
    if not manifest.is_file():
        return

    root = (MEDIA / kind).resolve()
    info("Removing R2-verified local media")

    for line in dict.fromkeys(manifest.read_text().splitlines()):
        if not line.strip():
            continue
        media_path = Path(line.strip())
        try:
            resolved = media_path.resolve()
            resolved.relative_to(root)
        except Exception:
            warn(f"Kept media outside the guarded cleanup root {root}: {media_path}")
            continue

        if resolved == root:
            warn(f"Refusing to remove the media root itself: {root}")
            continue

        try:
            if resolved.is_dir():
                shutil.rmtree(resolved)
                print(f"  removed local media folder: {resolved}")
            elif resolved.exists():
                resolved.unlink()
                print(f"  removed local media file: {resolved}")
            else:
                print(f"  local media was already absent: {resolved}")
        except OSError as error:
            warn(f"Could not remove verified local media {resolved}: {error}")
            continue
        remove_empty_media_parents(resolved, root)


def publish_media() -> None:
    need("rclone")
    info(f"Uploading finalized {MEDIA} to R2")
    subprocess.run(
        [
            "rclone",
            "copy",
            str(MEDIA) + "/",
            R2.rstrip("/") + "/",
            "--fast-list",
            "-P",
        ],
        check=True,
    )

    info("Verifying R2")
    subprocess.run(
        [
            "rclone",
            "check",
            str(MEDIA) + "/",
            R2.rstrip("/") + "/",
            "--size-only",
            "--one-way",
        ],
        check=True,
    )


def choose():
    print("\nW41IT VIDEO ADD\n  1. Anime\n  2. YouTube")
    while True:
        value = input("Select video type [1-2]: ").strip().lower()
        if value in ("1", "a", "anime"):
            return "anime", "anime-add"
        if value in ("2", "y", "yt", "youtube"):
            return "youtube", "youtube-add"


def initialize_appwrite() -> None:
    api_key()
    create_schema()
    catalog = seed_legacy()
    info("Migrating current video.js catalog to Appwrite TablesDB")
    save_catalog(catalog)
    print("\nAppwrite catalog ready. Git pushes are no longer needed for video metadata.")
    if ADMIN_USER_ID:
        print(f"  Admin writer: user:{ADMIN_USER_ID}")
    else:
        print(
            "  Admin writer: not configured "
            "(set VIDEO_ADMIN_USER_ID, then rerun --init-appwrite)"
        )


