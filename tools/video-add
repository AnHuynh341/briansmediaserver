    engine_path = need(engine)
    need("node")
    need("rclone")
    api_key()

    live = get_catalog()
    temporary_catalog = REPO / TEMP_NAME

    with tempfile.TemporaryDirectory(prefix="video-add-") as temp_directory:
        temp_directory = Path(temp_directory)
        source_manifest = temp_directory / "sources.txt"
        media_manifest = temp_directory / "media.txt"
        patched_engine = temp_directory / f"{kind}-workflow.py"
        patched_engine.write_text(
            patch_engine(engine_path.read_text(encoding="utf-8"), kind),
            encoding="utf-8",
        )
        temporary_catalog.write_text(
            render_js(engine_catalog(live)), encoding="utf-8"
        )

        env = os.environ.copy()
        env["VIDEO_ADD_SOURCE_MANIFEST"] = str(source_manifest)
        env["VIDEO_ADD_MEDIA_MANIFEST"] = str(media_manifest)
        if kind == "anime":
            env["ANIME_FRONTEND_REPO"] = str(REPO)
            env["ANIME_CATALOG_FILE"] = TEMP_NAME
            env["ANIME_MEDIA_ROOT"] = str(MEDIA / "anime")
        else:
            env["YOUTUBE_FRONTEND_REPO"] = str(REPO)
            env["YOUTUBE_CATALOG_FILE"] = TEMP_NAME
            env["YOUTUBE_MEDIA_ROOT"] = str(MEDIA / "youtube")

        command = [sys.executable, str(patched_engine), *forwarded]
        if "--no-push" not in forwarded:
            command.append("--no-push")

        try:
            return_code = subprocess.run(command, env=env).returncode
            if return_code:
                return return_code

            updated = merge_display(live, parse_js(temporary_catalog))

            # Publishing order is deliberate: finalized local files -> R2 -> metadata.
            # If R2 upload/check fails, the new catalog entry never becomes visible.
            publish_media()
            info("Publishing catalog to Appwrite TablesDB")
            save_catalog(updated)
            cleanup_sources(kind, source_manifest)
            if keep_media:
                print("\nLocal processed media kept because --keep-media was used.")
            else:
                cleanup_published_media(kind, media_manifest)

            print(
                "\nSUCCESS\n"
                f"  Media: {MEDIA} -> R2\n"
                "  Catalog: Appwrite TablesDB\n"
                f"  Local media: {'kept' if keep_media else 'removed after verification'}\n"
                "  Git push: not required"
            )
            return 0
        finally:
            temporary_catalog.unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--init-appwrite", action="store_true")
    parser.add_argument(
        "--keep-media",
        action="store_true",
        help="keep finalized /srv/media files after successful R2 verification",
    )
    known, forwarded = parser.parse_known_args()
    if known.init_appwrite:
        initialize_appwrite()
        return 0
    return run(forwarded, keep_media=known.keep_media)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        raise SystemExit(130)
