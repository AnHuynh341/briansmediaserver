def load_env() -> None:
    path = Path(
        os.environ.get(
            "VIDEO_ADD_ENV_FILE",
            Path.home() / ".config/w41it/video-add.env",
        )
    ).expanduser()
    if not path.is_file():
        return

    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key_name, value = line.split("=", 1)
        os.environ.setdefault(
            key_name.strip(), value.strip().strip('"').strip("'")
        )


load_env()

ENDPOINT = os.environ.get(
    "APPWRITE_ENDPOINT", "https://sgp.cloud.appwrite.io/v1"
).rstrip("/")
PROJECT = os.environ.get("APPWRITE_PROJECT_ID", "6a0878e40013d0103042")
DATABASE = os.environ.get("APPWRITE_DATABASE_ID", "6a087bfc0014b3277171")
TABLE = os.environ.get("VIDEO_CATALOG_TABLE_ID", "video_catalog")
ROW = os.environ.get("VIDEO_CATALOG_ROW_ID", "current")
ADMIN_USER_ID = os.environ.get("VIDEO_ADMIN_USER_ID", "").strip()
R2 = os.environ.get("VIDEO_R2_REMOTE", "r2:w41it-video")
MEDIA = Path(os.environ.get("VIDEO_MEDIA_ROOT", "/srv/media"))
REPO = Path(
    os.environ.get(
        "VIDEO_FRONTEND_REPO", "/home/fedora/repos/briansmediaserver"
    )
)
LEGACY = REPO / "video.js"
