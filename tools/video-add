def discover_images_for_fzf() -> list[Path]:
    roots: list[Path] = []
    for candidate in (Path.home(), DOWNLOAD_DIR, Path.cwd()):
        try:
            candidate = candidate.expanduser().resolve()
        except OSError:
            continue
        if candidate.is_dir() and candidate not in roots:
            roots.append(candidate)

    ignored_directories = {
        ".cache",
        ".git",
        ".local",
        ".npm",
        ".rustup",
        ".cargo",
        "node_modules",
        "Trash",
    }
    images: dict[Path, None] = {}
    for root in roots:
        for current, directories, filenames in os.walk(root, onerror=lambda _error: None):
            directories[:] = [
                name for name in directories if name not in ignored_directories
            ]
            current_path = Path(current)
            for filename in filenames:
                path = current_path / filename
                if path.suffix.lower() in IMAGE_SUFFIXES:
                    try:
                        images[path.resolve()] = None
                    except OSError:
                        continue
    return sorted(
        images,
        key=lambda path: path.stat().st_mtime if path.exists() else 0,
        reverse=True,
    )


